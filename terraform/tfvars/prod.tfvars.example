project_id  = "your-prod-project"
region      = "asia-northeast1"
environment = "prod"
env         = "production"

api_image    = "asia-northeast1-docker.pkg.dev/your-prod-project/synthify-prod/api:latest"
worker_image = "asia-northeast1-docker.pkg.dev/your-prod-project/synthify-prod/worker:latest"

uploads_bucket_name  = "your-prod-project-synthify-uploads"
firebase_project_id  = "your-prod-project"
cors_allowed_origins = "https://app.example.com"
gemini_model         = "gemini-3-flash-preview"

# Two-pass apply: leave empty on first apply, then copy
# `terraform output -raw api_uri` here and re-apply.
api_base_url = ""

# --- Stripe ---
stripe_pro_price_id       = ""
stripe_pro_price_id_jpy   = ""
stripe_pro_price_id_usd   = ""
stripe_default_currency   = "jpy"
stripe_meter_input_event  = ""
stripe_meter_output_event = ""

# --- Billing redirect URLs ---
billing_success_url       = "https://app.example.com/workspaces?billing=success"
billing_cancel_url        = "https://app.example.com/workspaces?billing=cancel"
billing_portal_return_url = "https://app.example.com/workspaces"

new_relic_app_name = "synthify-api"
