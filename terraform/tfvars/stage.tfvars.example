project_id  = "your-stage-project"
region      = "asia-northeast1"
environment = "stage"
env         = "stage"

api_image    = "asia-northeast1-docker.pkg.dev/your-stage-project/synthify-stage/api:latest"
worker_image = "asia-northeast1-docker.pkg.dev/your-stage-project/synthify-stage/worker:latest"

uploads_bucket_name  = "your-stage-project-synthify-uploads"
firebase_project_id  = "your-stage-project"
cors_allowed_origins = "https://stage.example.com"
gemini_model         = "gemini-3-flash-preview"

# Two-pass apply: leave empty on first apply (worker boots fine),
# then copy `terraform output -raw api_uri` here and re-apply.
api_base_url = ""

# --- Stripe (blank disables billing handlers; secrets live in Secret Manager) ---
stripe_pro_price_id       = ""
stripe_pro_price_id_jpy   = ""
stripe_pro_price_id_usd   = ""
stripe_default_currency   = "jpy"
stripe_meter_input_event  = ""
stripe_meter_output_event = ""

# --- Billing redirect URLs ---
billing_success_url       = "https://stage.example.com/workspaces?billing=success"
billing_cancel_url        = "https://stage.example.com/workspaces?billing=cancel"
billing_portal_return_url = "https://stage.example.com/workspaces"

new_relic_app_name = "synthify-api-stage"
