{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthify.local/contracts/firestore/job-status.schema.json",
  "title": "FirestoreJobStatus",
  "description": "Transient Firestore document for job progress and UI notifications. Postgres/API remain the source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobId",
    "jobType",
    "documentId",
    "workspaceId",
    "treeId",
    "status",
    "currentStage",
    "errorMessage",
    "updatedAt"
  ],
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "jobType": {
      "type": "string",
      "minLength": 1
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "treeId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed"]
    },
    "currentStage": {
      "type": "string"
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "message": {
      "type": "string"
    },
    "errorMessage": {
      "type": "string"
    },
    "suggestedWorkspaceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "suggestedWorkspaceNameSource": {
      "type": "string",
      "enum": ["brief.topic"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "description": "Firestore Timestamp at which this document becomes eligible for automatic deletion by the TTL policy. Written as a native Firestore Timestamp (not RFC3339) so the platform-side TTL field selector can match it.",
      "type": ["object", "string", "number", "null"],
      "x-firestore-timestamp": true
    }
  }
}
