{
  "name": "synthify-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed --workers=1",
    "e2e:last": "playwright test --last-failed --workers=1",
    "e2e:pr": "playwright test --project=chromium --grep-invert \"@nightly|@demo\"",
    "e2e:demo": "playwright test --project=chromium --grep @demo",
    "e2e:repeat5": "playwright test --project=chromium --repeat-each=5",
    "e2e:nightly": "playwright test --project=nightly",
    "e2e:auth": "playwright test e2e/auth",
    "e2e:billing": "playwright test e2e/billing",
    "e2e:workspaces": "playwright test e2e/workspaces",
    "e2e:documents": "playwright test e2e/documents",
    "e2e:sharing": "playwright test e2e/sharing",
    "e2e:general": "playwright test e2e/general",
    "e2e:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps chromium",
    "generate:firestore-types": "node ../../scripts/generate-firestore-types.mjs",
    "seed:jobs": "node ./scripts/seed-firestore-jobs.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@keyhole-koro/paper-in-paper": "file:./vender/paper-in-paper",
    "@newrelic/browser-agent": "^1.315.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "firebase": "^12.12.0",
    "framer-motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.38",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.8.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.7"
  }
}
