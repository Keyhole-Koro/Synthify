{
  "name": "@synthify/monitor-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 5174",
    "gen:openapi": "openapi-typescript ../../../contracts/openapi/monitor.yaml -o ./src/generated/openapi.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 5174",
    "test": "bun test src",
    "screenshots": "node scripts/screenshots/run.mjs",
    "playwright:install": "playwright-core install --with-deps chromium"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "next": "^16.2.2",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "openapi-typescript": "^7.10.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "playwright-core": "^1.56.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
